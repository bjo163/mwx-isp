# ============================================================
# MWX-ISP - Coolify environment variables
# Copy everything below the header into Coolify -> Your App ->
# Variables (Resources) and save, then Deploy.
# Format: KEY=value (no "export", no quotes).
# Comments must be on their own line: an inline "# ..." after a value becomes
# part of that value, so the generator commands below sit on the line above.
# ============================================================

# ---------- REQUIRED (deployment fails without these) ----------
# Replace every CHANGE_ME_* value before Deploy. Generator commands are on the
# line above each variable. Do not use "$" in a value: docker compose would try
# to interpolate it.

# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# openssl rand -hex 32
MWX_ISP_WEB_SECRET=CHANGE_ME_web_session_secret

# openssl rand -base64 24 | tr -d '/+='
# First-start admin password for the default "admin" login. Changing it later
# does NOT rotate an existing account (use cmd/reset-password).
MWX_ISP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---------- Database (must match POSTGRES_PASSWORD above) ----------
# The app reaches Postgres inside the compose network with these values; the db
# port is not published to the host.
POSTGRES_DB=mwxisp
POSTGRES_USER=mwxisp

# ---------- Images ----------
MWX_ISP_IMAGE=ghcr.io/bjo163/mwx-isp:latest
MWX_ISP_POSTGRES_IMAGE=postgres:16-alpine3.24

# ---------- System ----------
TZ=Asia/Jakarta

# ---------- Web access: behind the Coolify (Traefik) proxy ----------
# Pair with these Coolify settings:
#   - Proxy stays ENABLED for this resource (do not enable "Bypass proxy").
#   - Point the Coolify domain (and any extra domain) at port 1816 of the app
#     service, so Traefik terminates TLS and forwards to app:1816. Caddy here
#     is published on the host loopback only and never takes host 80/443.
#   - Publish only the app/RADIUS ports you need: 1812/1813/udp and 2083/tcp.
# Alternative - let Caddy serve the public site: set MWX_ISP_CADDY_BIND=0.0.0.0,
# put the real hostname in MWX_ISP_DOMAIN and MWX_ISP_CADDY_ADDRESS, leave
# MWX_ISP_CADDY_TLS_DIRECTIVE empty for automatic Let's Encrypt, and disable
# Coolify's proxy for this resource so 80/443 stay free.
MWX_ISP_DOMAIN=localhost
MWX_ISP_CADDY_ADDRESS=localhost
MWX_ISP_CADDY_TLS_DIRECTIVE=tls internal
MWX_ISP_CADDY_BIND=127.0.0.1
MWX_ISP_WEB_PORT=1816

# ---------- Optional platform (multi-tenant) admin bootstrap ----------
# Leave both empty for a single-tenant install. If set, the password must be
# at least 12 characters and the username must not already exist.
MWX_PLATFORM_ADMIN_USERNAME=
MWX_PLATFORM_ADMIN_PASSWORD=
